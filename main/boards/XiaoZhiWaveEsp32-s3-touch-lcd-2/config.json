{
    "target": "esp32s3",
    "builds": [
        {
            "name": "XiaoZhiWaveEsp32-s3-touch-lcd-2",
            "sdkconfig_append": [
                "CONFIG_USE_WECHAT_MESSAGE_STYLE=n",
                "CONFIG_USE_EMOTE_MESSAGE_STYLE=y",
                "CONFIG_MMAP_FILE_NAME_LENGTH=32",
                "CONFIG_FLASH_EXPRESSION_ASSETS=y",
                "CONFIG_USE_AFE_WAKE_WORD=y",
                "CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=n",
                "CONFIG_SR_WN_WN9_HIMIAOMIAO_TTS=y",
                "CONFIG_SR_WN_WN9_MIAOMIAOTONGXUE_TTS=y",
                "CONFIG_USE_DEVICE_AEC=n",
                "CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y",
                "CONFIG_ESP_CONSOLE_UART_DEFAULT=n",
                "CONFIG_ESP_CONSOLE_SECONDARY_NONE=y",
                "CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=n",
                "CONFIG_BOARD_TYPE_XIAOZHIWAVE_ESP32_S3_TOUCH_LCD_2=y",
                "CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/v2/16m_6m_4m_assets.csv\"",
                "CONFIG_OTA_URL=\"http://xz.atchain.cn/ota/\""
            ]
        }
    ]
}
